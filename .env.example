# Copy to .env and source it, or just export these in your shell.
# The demo runs fine with none of them set - the generative layer falls back to
# extractive mode and the header pill tells you which mode is active.

# Which adapter to use: anthropic | openai | gemini | groq | auto
# auto = first provider whose SDK is installed and whose API key is present.
LLM_PROVIDER=auto

# Override the provider's default model (claude-opus-5 / gpt-4.1 / gemini-2.5-pro).
# Verify the id against the provider's current model list before relying on it.
# LLM_MODEL=

# Reasoning depth: low | medium | high. Low keeps latency in the range a chat
# surface needs. Each adapter maps this to its own vendor parameter.
LLM_EFFORT=low

# OpenAI only: reasoning_effort is rejected by non-reasoning models, so it is
# only sent when this is set. Leave unset unless LLM_MODEL is a reasoning model.
# LLM_REASONING_EFFORT=1

# --- credentials: set whichever provider you're using ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Groq: a first-class provider, not a base-URL override. It uses the openai
# package as its client but has its own key and its own default model, so
# LLM_PROVIDER=groq plus this key is the whole setup. Best free tier of the four.
# GROQ_API_KEY=gsk_...

# --- TTS (text-to-speech) ---
# ElevenLabs: the default TTS provider. With this key set, app/tts.py calls
# ElevenLabs directly (plain request/response, no public URL needed); without
# it, TTS falls back to gTTS. The voice_id is chosen in the Settings screen and
# should match the demo recordings in data/voice_cache/manifest.json.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_multilingual_v2
#
# VieNeu-TTS: giọng tiếng Việt chạy LOCAL (không cần key, offline, hợp Mac M4).
# Chạy service VieNeu ở env uv riêng, cổng KHÁC 8000 (chatbot đang dùng 8000):
#   cd VieNeu-TTS && VIENEU_PORT=8080 uv run python -m apps.openai_speech
# Rồi chọn provider "Voice 3" ở màn hình Cấu hình → Giọng nói. Nếu chạy cổng
# khác, đổi VIENEU_URL cho khớp. Chuỗi ưu tiên: VieNeu → file thu (.mp3) → gTTS.
# VIENEU_URL=http://127.0.0.1:8080/v1/audio/speech
# VIENEU_MODEL=vieneu-v3-turbo

# --- other OpenAI-compatible endpoints ---
# The openai adapter also drives any compatible gateway via OPENAI_BASE_URL:
#
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#               OPENAI_API_KEY=sk-or-... LLM_MODEL=<a ":free" model id>
#   Local:      OPENAI_BASE_URL=http://localhost:8080/v1   (llama.cpp, vLLM, Ollama)
#
# Note: gateways generally do not implement OpenAI's `refusal` field, so a
# safety block arrives as ordinary text and only the grounding gate catches it.
# OPENAI_BASE_URL=
